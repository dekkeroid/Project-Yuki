# =============================================================================
# Yuki Backend Configuration (Default)
# =============================================================================
# This file is copied to .env on first run.
# Edit .env (next to backend.exe) to override any value.
# You do NOT need to touch this file.
# =============================================================================

# ── Network ────────────────────────────────────────────────────────────────

# Bind address: 127.0.0.1 = localhost only (safe default)
#              0.0.0.0   = accessible from LAN (for remote dev / other devices)
YUKI_HOST=127.0.0.1

# Backend port (default: 58392 — high random port to avoid conflicts)
YUKI_PORT=58392

# ── LLM Backend ──────────────────────────────────────────────────────────────

# Which LLM provider to use: lmstudio | ollama | vllm | openai | groq | together | deepseek | custom | none
LLM_BACKEND=lmstudio

# Display name for custom backends (leave empty for built-in providers)
LLM_BACKEND_TITLE=

# API key for cloud backends (openai, groq, together, deepseek). Leave empty for local.
LLM_API_KEY=

# Base URL override — leave empty to use the per-backend default
LLM_BASE_URL=

# LM Studio server address (default for lmstudio backend)
LMSTUDIO_URL=http://127.0.0.1:1234

# ── LLM Settings ─────────────────────────────────────────────────────────────

# Model used for simple/primary tasks
LLM_MODEL=llama-3.2-3b-instruct

# Model used for complex reasoning tasks (only used in LLM_MODE=0)
LLM_MODEL_COMPLEX=nvidia/nemotron-3-nano-4b

# LLM routing mode:
#   0 = auto (simple model for easy tasks, complex model for hard tasks)
#   1 = force simple model for everything (no tools)
#   2 = force complex model for everything
#   3 = smart single (one model, but uses full tool-aware prompt for complex tasks)
LLM_MODE=3

# ── Tool Transport ───────────────────────────────────────────────────────────

# How tool calls reach the actual tool functions:
#   mcp-stdio = route through a child process via stdin/stdout JSON-RPC
#   local     = run tool functions directly in the same Python process (default)
YUKI_TOOL_TRANSPORT=local

# If MCP subprocess fails to start, fall back to the legacy local dispatcher
YUKI_MCP_FALLBACK_TO_LOCAL=true

# Legacy flag: if true, send ALL tool schemas to the LLM (overrides selection mode)
YUKI_MCP_SEND_ALL_TOOLS=false

# ── Tool Selection ───────────────────────────────────────────────────────────

# How the system picks which tools to show the LLM (saves context tokens):
#   auto     = score tool schemas against the user query and pick the top matches (default)
#   keyword  = use the older hardcoded keyword-bucket filtering
#   all      = send every tool (no filtering)
YUKI_TOOL_SELECTION_MODE=auto

# Maximum number of tools to send to the LLM when using "auto" mode
YUKI_TOOL_SELECTION_MAX_TOOLS=8

# If the best tool score is below this, send ALL tools instead of risking a miss
YUKI_TOOL_SELECTION_FALLBACK_THRESHOLD=0.08

# ── Safety Sandbox ───────────────────────────────────────────────────────────

# Master switch for the tool safety sandbox
YUKI_TOOL_SANDBOX_ENABLED=true

# Comma-separated list of tools to block entirely (e.g. "run_terminal_command,delete_file")
YUKI_TOOL_SANDBOX_BLOCKED_TOOLS=

# Comma-separated list of tools that require user confirmation before execution
YUKI_TOOL_SANDBOX_REQUIRE_CONFIRMATION_TOOLS=launch_app,create_file,edit_file,delete_file,system_power_control,run_terminal_command,run_python_script,keyboard_mouse_input,manage_process,control_window

# Power actions blocked even with confirmation (default: shutdown and restart)
YUKI_TOOL_SANDBOX_BLOCKED_POWER_ACTIONS=shutdown,restart

# Extra terminal command regex patterns to block (added to built-in destructive patterns)
YUKI_TOOL_SANDBOX_BLOCKED_TERMINAL_PATTERNS=

# How long confirmation grants stay valid before expiring (seconds)
YUKI_TOOL_CONFIRMATION_GRANT_TTL_SECONDS=120

# ── Chat History ─────────────────────────────────────────────────────────────

# Maximum number of past user/assistant turn pairs to include in LLM context
CHAT_HISTORY_LIMIT=6

# ── TTS (Text-to-Speech) ────────────────────────────────────────────────────

# Voice selection for Kokoro-82M neural TTS:
#   af_sarah   = Cute US Female (default)
#   af_sky     = Natural US Female
#   am_adam    = Natural US Male
#   am_michael = Deep US Male
TTS_VOICE=af_sarah

# Speech speed multiplier (1.0 = normal, 1.5 = faster, 0.75 = slower)
TTS_RATE=1.0

# Device for TTS inference: auto | gpu | cpu
TTS_DEVICE=auto

# Preload TTS model on startup (true = faster first response, uses ~250-400 MB extra RAM)
TTS_PRELOAD=true

# ── STT (Speech-to-Text) ────────────────────────────────────────────────────

# Device for Whisper STT inference: auto | gpu | cpu
STT_DEVICE=auto

# ── Crawler Paths ────────────────────────────────────────────────────────────

# Comma-separated list of priority folders to scan first (before drive sweep).
# Leave empty to auto-scan ~/Downloads, ~/Videos, ~/Music, ~/Documents.
YUKI_CRAWLER_PRIORITY_PATHS=

# Which drive to prioritize as the first scan target.
# Leave empty to auto-detect (first non-system drive found).
YUKI_CRAWLER_PRIMARY_DRIVE=

# ── Development ──────────────────────────────────────────────────────────────

# Set to 1 to enable uvicorn auto-reload on file changes (dev only, default: off)
YUKI_DEV_RELOAD=0
