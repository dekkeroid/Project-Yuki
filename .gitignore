# Node dependencies
node_modules/
frontend/dist/
frontend/build/

#yuki home
yuki home/
testing/
!testing/tool_tester.html

# Python caching and environments
__pycache__/
*.pyc
.env
venv/
.venv/

# Local databases and logs (Crucial for your app)
yuki_files.db
yuki_files.db-wal
yuki_files.db-shm
yuki.db
yuki.db-wal
yuki.db-shm
yuki_crawler.log
metadata_tagger.log

# Ignore all 3D VRM characters globally
*.vrm

# EXCEPT for the explicit default character asset
!frontend/public/models/default.vrm
!frontendUnityV2/Assets/**/*.vrm

# Python testing sandbox files (Scratch directory)
backend/scratch/
backend/tests/
scratch_scripts/
backend/test.mp3
backend/TODO.md

# Virtual Environment configuration tracking
backend/venv/
backend/.venv/

# Local personal runtime states
backend/profile.json
backend/.yuki_confirmation_grants.json
backend/.yuki_confirmation_grants.json.*
backend/yuki_attachment/*
backend/debug_audio/

# Ignore local Kokoro AI model weights and audio binary matrices
backend/app/voice/*.onnx
backend/app/voice/*.bin

# Bundled whisper model (downloaded, ~141MB)
backend/app/voice/whisper-base/

# PyInstaller build artifacts
backend/build/
backend/dist/
backend/tests/*

# Runtime marker file
backend/.yuki-ready

# Runtime tool execution logs
backend/tool_runs.jsonl

# Electron-builder and installer output
frontend/release/
frontend/installer-output/

*.bat
!start_build.bat

# Unity frontend generated files
frontendUnityV2/Library/
frontendUnityV2/Temp/
frontendUnityV2/Obj/
frontendUnityV2/Build/
frontendUnityV2/Builds/
frontendUnityV2/Logs/
frontendUnityV2/UserSettings/
frontendUnityV2/.vs/
frontendUnityV2/.codegraph/
frontendUnityV2/ProjectSettings/SceneTemplateSettings.json
frontendUnityV2/Assets/TextMesh Pro/
frontendUnityV2/Assets/TextMesh Pro.meta

# Unity generated project files globally
*.csproj
*.sln
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
