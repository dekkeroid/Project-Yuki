# Node dependencies
node_modules/
frontend/dist/

#yuki home
yuki home/

# Python caching and environments
__pycache__/
*.pyc
.env
venv/
.venv/

# Local databases and logs (Crucial for your app)
yuki_files.db
yuki_files.db-wal
yuki_files.db-shm
yuki_crawler.log

# Ignore all 3D VRM characters globally
*.vrm

# EXCEPT for the explicit default character asset
!frontend/public/models/default.vrm
!frontendUnity/Assets/**/*.vrm
!frontendUnityV2/Assets/**/*.vrm

# Python testing sandbox files (Scratch directory)
backend/scratch/
backend/test.mp3

# Virtual Environment configuration tracking
backend/venv/
backend/.venv/

# Local personal runtime states
backend/profile.json
backend/.yuki_confirmation_grants.json
backend/.yuki_confirmation_grants.json.*

# Ignore local local Kokoro AI model weights and audio binary matrices
backend/app/voice/*.onnx
backend/app/voice/*.bin

*.bat
# Unity frontend generated files
frontendUnity/Library/
frontendUnity/Temp/
frontendUnity/Obj/
frontendUnity/Build/
frontendUnity/Builds/
frontendUnity/Logs/
frontendUnity/UserSettings/
frontendUnity/.vs/
frontendUnity/.codegraph/

# Unity frontend generated files
frontendUnityV2/Library/
frontendUnityV2/Temp/
frontendUnityV2/Obj/
frontendUnityV2/Build/
frontendUnityV2/Builds/
frontendUnityV2/Logs/
frontendUnityV2/UserSettings/
frontendUnityV2/.vs/
frontendUnityV2/.codegraph/

